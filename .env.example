# Core
SECRET_KEY=change-me-in-production
# Defaults to true when unset (local dev). Production must set false explicitly.
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
ENVIRONMENT=development
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (omit for SQLite file ./db.sqlite3)
DATABASE_URL=

# Docker / paths
DOCKER_ENV=false

# JWT
JWT_LONG_LIVED=false

# SMS (OTP / Pywe gateway). Set URL + keys for real SMS; leave SMS_API_BASE_URL empty for dev (OTP only in logs).
SMS_API_BASE_URL=https://pushr.pywe.org
SMS_API_KEY_PUBLIC=
SMS_API_KEY_SECRET=
SMS_SENDER_ID=
SMS_BRAND_NAME=Pywe
PHONENUMBER_DEFAULT_REGION=GH

# Domain-specific
BASE_URL=http://localhost:8000
