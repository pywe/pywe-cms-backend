# Core
SECRET_KEY=change-me-in-production
# Defaults to true when unset (local dev). Production must set false explicitly.
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
ENVIRONMENT=development
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (omit for SQLite file ./db.sqlite3)
DATABASE_URL=

# Docker / paths
DOCKER_ENV=false

# JWT (1-day access by default; set JWT_LONG_LIVED=true for 365-day tokens)
JWT_LONG_LIVED=false

# SMS (OTP / Pywe gateway). Set URL + keys for real SMS; leave keys empty for dev (OTP only in logs).
SMS_API_BASE_URL=https://pushr.pywe.org
SMS_API_KEY_PUBLIC=
SMS_API_KEY_SECRET=
SMS_SENDER_ID=Pywe
SMS_BRAND_NAME=Pywe
PHONENUMBER_DEFAULT_REGION=GH
MERCHANT_SMS_DEV_SHOW_CODE=false
STORE_OWNER_DASHBOARD_URL=https://account.pywe.org/dashboard
STORE_OWNER_APP_URL=

# Email (optional; Resend)
USE_RESEND=true
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=

# Domain-specific
BASE_URL=http://localhost:8000
